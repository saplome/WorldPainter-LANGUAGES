<!-- Modified in 2026 for WorldPainter Languages, an unofficial localization fork of
     WorldPainter (https://github.com/saplome/WorldPainter-LANGUAGES).

     The file above is jpackage's own WiX dialog resource, copied out of the JDK
     (jdk.jpackage/resources) and changed only so the dialog speaks Russian: the WiX
     !(loc.*) string references are replaced with literal text, because jpackage loads
     MsiInstallerStrings_*.wxl for en, ja and zh_CN only, never for ru.
     Modifications Copyright (C) 2026 saplome.

     Oracle's header above is kept verbatim, as that header itself requires. The original
     file stays under GPL version 2 with the Classpath exception; it is a build-time
     resource that jpackage takes from its resource-dir and is not application source. -->

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Fragment>
    <Binary Id="JpCaDll" SourceFile="wixhelper.dll"/>
    <CustomAction Id="JpCheckInstallDir" BinaryKey="JpCaDll" DllEntry="CheckInstallDir" />

    <UI>
      <Dialog Id="InstallDirNotEmptyDlg" Width="300" Height="85" Title="Установка [ProductName]">
        <Control Id="Yes" Type="PushButton" X="100" Y="55" Width="50" Height="15" Default="no" Cancel="no" Text="Да">
          <Publish Event="NewDialog" Value="$(var.JpAfterInstallDirDlg)">1</Publish>
        </Control>
        <Control Id="No" Type="PushButton" X="150" Y="55" Width="50" Height="15" Default="yes" Cancel="yes" Text="Нет">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="Text" Type="Text" X="25" Y="15" Width="250" Height="30" TabSkip="no">
          <Text>Папка [INSTALLDIR] уже существует. Всё равно установить приложение в эту папку?</Text>
        </Control>
      </Dialog>

      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="JpCheckInstallDir" Order="3">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="InstallDirNotEmptyDlg" Order="5">INSTALLDIR_VALID="0"</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="$(var.JpAfterInstallDirDlg)" Order="5">INSTALLDIR_VALID="1"</Publish>
    </UI>
  </Fragment>
</Wix>
