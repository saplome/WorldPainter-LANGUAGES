<!-- Modified in 2026 for WorldPainter Languages, an unofficial localization fork of
     WorldPainter (https://github.com/saplome/WorldPainter-LANGUAGES).

     The file above is jpackage's own WiX dialog resource, copied out of the JDK
     (jdk.jpackage/resources) and changed only so the dialog speaks Russian: the WiX
     !(loc.*) string references are replaced with literal text, because jpackage loads
     MsiInstallerStrings_*.wxl for en, ja and zh_CN only, never for ru.
     Modifications Copyright (C) 2026 saplome.

     Oracle's header above is kept verbatim, as that header itself requires. The original
     file stays under GPL version 2 with the Classpath exception; it is a build-time
     resource that jpackage takes from its resource-dir and is not application source. -->

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?define JpDesktopShortcutPromptControlY=140 ?>
  <?define JpStartMenuShortcutPromptControlY=180 ?>

  <?ifndef JpDesktopShortcutPrompt ?>
    <?define JpStartMenuShortcutPromptControlY=$(var.JpDesktopShortcutPromptControlY) ?>
  <?endif?>

  <Fragment>
    <UI>
      <Dialog Id="ShortcutPromptDlg" Width="370" Height="270" Title="Установка [ProductName]" NoMinimize="yes">
        <Control Id="Description" Type="Text" X="25" Y="23" Width="300" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Выберите, какие ярлыки нужно создать." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Ярлыки" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                 Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <?ifdef JpDesktopShortcutPrompt ?>
        <Control Type="CheckBox" X="20" Width="280" Height="17" CheckBoxValue="1"
                 Id="InstallDesktopShortcut"
                 Y="$(var.JpDesktopShortcutPromptControlY)"
                 Property="JP_INSTALL_DESKTOP_SHORTCUT"
                 Text="Создать ярлык на рабочем столе"/>
        <?endif?>

        <?ifdef JpStartMenuShortcutPrompt ?>
        <Control Type="CheckBox" X="20" Width="280" Height="17" CheckBoxValue="1"
                 Id="InstallStartMenuShortcut"
                 Y="$(var.JpStartMenuShortcutPromptControlY)"
                 Property="JP_INSTALL_STARTMENU_SHORTCUT"
                 Text="Создать ярлык в меню «Пуск»"/>
        <?endif?>

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="Далее" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="Назад" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="Отмена">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
